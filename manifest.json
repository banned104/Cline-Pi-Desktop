          },
          {
            "id": "cline-pass/qwen3.8-max",
            "name": "Qwen3.8 Max (ClinePass)",
            "contextWindow": 128000,
            "maxTokens": 8192,
            "supportsImages": false
          }
        ]
      }
    ]
  },
  "permissions": ["provider.register"],
  "engines": { "piDesktop": ">=0.1.0" }
}
