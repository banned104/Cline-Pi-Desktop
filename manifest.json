{
  "schemaVersion": 1,
  "id": "pi.clinepass",
  "name": "ClinePass",
  "version": "2.0.0",
  "description": "Adds Cline's ClinePass subscription as two providers: a direct one over Cline's OpenAI-compatible chat completions API, and a loopback one that forwards the same requests and reports which upstream Cline's gateway actually used (finalProvider, pinnedProvider, fallbacksAvailable, prompt-cache hits, cost). Both declare the same 15 ClinePass models, taken from Cline's own catalog.",
  "author": "local",
  "main": "main.js",
  "permissions": [
    "provider.register",
    "ui.panel",
    "background.service"
  ],
  "ui": {
    "panel": "renderer/index.html",
    "title": {
      "en": "ClinePass upstreams",
      "zh-CN": "ClinePass 上游"
    },
    "width": 1040,
    "height": 760
  },
  "i18n": {
    "en": {
      "name": "ClinePass",
      "description": "Cline's ClinePass subscription as two providers: a direct one, and a loopback one that shows which upstream each request really landed on (with fallbacks, cache hits and cost) and can anchor a model to a chosen upstream by rewriting its id.",
      "safetyNotes": "Runs a loopback OpenAI-compatible endpoint on 127.0.0.1:41892 and forwards chat requests to api.cline.bot. The API key is taken from the Authorization header the host sends for the provider row, or from this plugin's own settings (DPAPI-encrypted on Windows); it is used only to reach api.cline.bot. Responses are read in memory to extract the gateway's routing metadata, and the last result per model is kept in the plugin data directory. Nothing is sent anywhere except api.cline.bot and the local panel."
    },
    "zh-CN": {
      "name": "ClinePass",
      "description": "把 Cline 的 ClinePass 订阅声明成两个服务商：一个直连，一个走本机回环转发并报告每个请求真实落在哪个上游（含备选、缓存命中与成本），还可以通过改写模型 id 把某个模型锚定到指定上游。",
      "safetyNotes": "在本机 127.0.0.1:41892 跑一个 OpenAI 兼容端点，把对话请求转发到 api.cline.bot。API Key 优先取宿主为该服务商行发送的 Authorization 头，其次取插件自己的设置（Windows 上用 DPAPI 加密），只用于访问 api.cline.bot。响应在内存中读取网关的路由元数据，只把每个模型的最近一次结果存到插件数据目录。除 api.cline.bot 与本地面板外不向任何地方发送数据。"
    }
  },
  "contributes": {
    "commands": [
      {
        "id": "clinepass.upstream.open",
        "title": "ClinePass: 打开上游面板",
        "category": "Productivity",
        "keywords": [
          "cline",
          "clinepass",
          "upstream",
          "上游",
          "路由"
        ]
      },
      {
        "id": "clinepass.upstream.clear",
        "title": "ClinePass: 清空上游检测记录",
        "category": "Productivity",
        "keywords": [
          "cline",
          "clinepass",
          "clear",
          "清空"
        ]
      }
    ],
    "services": [
      {
        "id": "clinepass-upstream-host",
        "label": "ClinePass upstream observer (loopback provider host)"
      }
    ],
    "settings": [
      {
        "key": "enabled",
        "type": "boolean",
        "title": "启用上游观察端点（关闭后回环服务商一律 503）",
        "default": true
      },
      {
        "key": "apiKey",
        "type": "string",
        "title": "ClinePass API Key（可选：留空则用宿主发给服务商行的那个 key）",
        "default": ""
      },
      {
        "key": "apiKeyEnc",
        "type": "string",
        "title": "加密后的 key（Windows DPAPI，插件自动维护，请勿手动修改）",
        "default": ""
      },
      {
        "key": "enabledModels",
        "type": "string",
        "title": "启用哪些模型（逗号或空格分隔；留空 = 全部；面板里有勾选界面）",
        "default": ""
      },
      {
        "key": "preferredUpstream",
        "type": "string",
        "title": "目标上游（逗号分隔，可多个；留空 = 只观察）",
        "default": ""
      },
      {
        "key": "injectRouting",
        "type": "boolean",
        "title": "尝试写入路由字段 provider.only（实测 Cline 网关忽略）",
        "default": false
      },
      {
        "key": "hardPin",
        "type": "boolean",
        "title": "同时写入 allow_fallbacks: false（实测同样被忽略）",
        "default": false
      },
      {
        "key": "toastOnMismatch",
        "type": "boolean",
        "title": "实际落点与目标不符时提示",
        "default": true
      },
      {
        "key": "modelThinking",
        "type": "string",
        "title": "每个模型的默认思考强度（JSON，面板自动维护）",
        "default": ""
      },
      {
        "key": "modelIdOverride",
        "type": "string",
        "title": "锚定上游用的 id 改写表（JSON，面板自动维护）",
        "default": ""
      },
      {
        "key": "upstreamProbe",
        "type": "string",
        "title": "上游探测结果（JSON，面板自动维护）",
        "default": ""
      },
      {
        "key": "routingSnapshot",
        "type": "string",
        "title": "最近一次路由快照（插件自动写入，请勿修改）",
        "default": ""
      }
    ],
