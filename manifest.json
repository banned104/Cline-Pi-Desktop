{
  "schemaVersion": 1,
  "id": "pi.clinepass",
  "name": "ClinePass",
  "version": "1.2.0",
  "description": "Adds Cline's ClinePass subscription as a provider, over Cline's OpenAI-compatible chat completions API. Hard-codes the 14 ClinePass models from Cline's own catalog with their real context window, output limit, image support and reasoning effort levels.",
  "author": "local",
  "main": "main.js",
  "contributes": {
    "providers": [
      {
        "id": "clinepass",
        "name": "ClinePass",
        "vendorKey": "custom",
        "apiStyle": "chat_completions",
        "authKind": "api_key",
        "baseUrl": "https://api.cline.bot/api/v1",
        "models": [
          {
            "id": "cline-pass/glm-5.3",
            "name": "GLM-5.3 (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 943718,
            "supportsImages": false,
            "thinkingLevels": ["low", "high", "max"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "cline-pass/glm-5.3-flash",
            "name": "GLM-5.3-Flash (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 943717,
            "supportsImages": true,
            "thinkingLevels": ["low", "high", "max"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "cline-pass/kimi-k3",
            "name": "Kimi K3 (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 943718,
            "supportsImages": true,
            "thinkingLevels": ["low", "high", "max"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "cline-pass/deepseek-v4-pro",
            "name": "DeepSeek V4 Pro (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 384000,
            "supportsImages": false,
            "thinkingLevels": ["high", "xhigh"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "cline-pass/deepseek-v4.1-flash",
            "name": "DeepSeek V4.1 Flash (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 943718,
            "supportsImages": true,
            "thinkingLevels": ["low", "high", "max"],
            "defaultThinkingLevel": "high"
          },
          {
            "id": "cline-pass/muse-spark-1.3-contributor",
            "name": "Muse Spark 1.3 Contributor (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 943718,
            "supportsImages": true,
            "thinkingLevels": ["minimal", "low", "medium", "high", "xhigh", "max"],
            "defaultThinkingLevel": "medium"
          },
          {
            "id": "cline-pass/mimo-v2.5",
            "name": "MiMo-V2.5 (ClinePass)",
            "contextWindow": 1050000,
            "maxTokens": 131072,
            "supportsImages": true
          },
          {
            "id": "cline-pass/mimo-v2.5-pro",
            "name": "MiMo-V2.5-Pro (ClinePass)",
            "contextWindow": 1050000,
            "maxTokens": 131072,
            "supportsImages": false
          },
          {
            "id": "cline-pass/mimo-v2.6-flash",
            "name": "MiMo-V2.6-Flash (ClinePass)",
            "contextWindow": 1050000,
            "maxTokens": 131072,
            "supportsImages": true
          },
          {
            "id": "cline-pass/mimo-v2.6-pro",
            "name": "MiMo-V2.6-Pro (ClinePass)",
            "contextWindow": 1050000,
            "maxTokens": 131072,
            "supportsImages": true
          },
          {
            "id": "cline-pass/minimax-m3",
            "name": "MiniMax-M3 (ClinePass)",
            "contextWindow": 1048576,
            "maxTokens": 512000,
            "supportsImages": true
          },
          {
            "id": "cline-pass/qwen3.7-max",
            "name": "Qwen3.7 Max (ClinePass)",
            "contextWindow": 1000000,
            "maxTokens": 131072,
